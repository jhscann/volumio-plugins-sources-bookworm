{
  "page": {"label": "TRANSLATE.WIRELESS_OUTPUT_MANAGER"},
  "sections": [
    {
      "id": "speakerSetup",
      "element": "section",
      "label": "TRANSLATE.SPEAKER_SETUP",
      "icon": "fa-bluetooth-b",
      "description": "TRANSLATE.SPEAKER_SETUP_INTRO",
      "onSave": {"type": "controller", "endpoint": "system_hardware/wireless_output_manager", "method": "pairAndConnectDevice"},
      "saveButton": {"label": "TRANSLATE.PAIR_AND_CONNECT", "data": ["preferredDevice"]},
      "content": [
        {"id": "scanDevices", "element": "button", "label": "TRANSLATE.FIND_SPEAKERS", "description": "TRANSLATE.FIND_SPEAKERS_NOTE", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "scanDevices", "data": []}},
        {"id": "preferredDevice", "element": "select", "label": "TRANSLATE.AVAILABLE_SPEAKERS", "value": {"value": "", "label": "No speaker selected"}, "options": []}
      ]
    },
    {
      "id": "audioOutput",
      "element": "section",
      "label": "TRANSLATE.AUDIO_DESTINATION",
      "icon": "fa-volume-up",
      "description": "TRANSLATE.AUDIO_DESTINATION_NOTE",
      "content": [
        {"id": "createOutput", "element": "button", "label": "TRANSLATE.PLAY_ON_WIRELESS", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "createBluetoothOutput", "data": []}},
        {"id": "removeOutput", "element": "button", "label": "TRANSLATE.PLAY_ON_DEFAULT", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "removeBluetoothOutput", "data": []}}
      ]
    },
    {
      "id": "speakerManagement",
      "element": "section",
      "label": "TRANSLATE.SAVED_SPEAKER",
      "icon": "fa-headphones",
      "description": "TRANSLATE.SAVED_SPEAKER_NOTE",
      "content": [
        {"id": "connectDevice", "element": "button", "label": "TRANSLATE.RECONNECT_SPEAKER", "hidden": false, "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "connectDevice", "data": []}},
        {"id": "disconnectDevice", "element": "button", "label": "TRANSLATE.DISCONNECT_SPEAKER", "hidden": false, "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "disconnectDevice", "data": []}},
        {"id": "forgetDevice", "element": "button", "label": "TRANSLATE.FORGET_SPEAKER", "description": "TRANSLATE.FORGET_SPEAKER_NOTE", "hidden": false, "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "forgetDevice", "data": []}}
      ]
    },
    {
      "id": "preferences",
      "element": "section",
      "label": "TRANSLATE.PREFERENCES",
      "icon": "fa-cog",
      "onSave": {"type": "controller", "endpoint": "system_hardware/wireless_output_manager", "method": "saveSettings"},
      "saveButton": {"label": "TRANSLATE.SAVE", "data": ["autoReconnect", "debugLogging"]},
      "content": [
        {"id": "autoReconnect", "element": "switch", "label": "TRANSLATE.AUTO_RECONNECT_SPEAKER", "description": "TRANSLATE.AUTO_RECONNECT_NOTE", "value": true},
        {"id": "debugLogging", "element": "switch", "label": "TRANSLATE.DEBUG_LOGGING", "value": false}
      ]
    },
    {
      "id": "diagnostics",
      "element": "section",
      "label": "TRANSLATE.DIAGNOSTICS",
      "icon": "fa-stethoscope",
      "description": "TRANSLATE.DIAGNOSTICS_NOTE",
      "content": [
        {"id": "runDiagnostics", "element": "button", "label": "TRANSLATE.RUN_DIAGNOSTICS", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "runDiagnostics", "data": []}},
        {"id": "exportDebugLog", "element": "button", "label": "TRANSLATE.EXPORT_DEBUG_LOG", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "exportDebugLog", "data": []}},
        {"id": "refreshUI", "element": "button", "label": "TRANSLATE.REFRESH_STATUS", "onClick": {"type": "controller", "endpoint": "system_hardware/wireless_output_manager", "method": "getUIConfig", "data": []}},
        {"id": "diagnosticOutput", "element": "textarea", "label": "TRANSLATE.DIAGNOSTIC_OUTPUT", "value": ""},
        {"id": "lastError", "element": "textarea", "label": "TRANSLATE.LAST_ERROR", "value": "None"}
      ]
    }
  ]
}
