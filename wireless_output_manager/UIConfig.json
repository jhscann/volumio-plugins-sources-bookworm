        {"id": "fallbackOutput", "element": "select", "label": "FALLBACK_OUTPUT", "value": {"value": "previous", "label": "Previous output"}, "options": [{"value": "previous", "label": "Previous output"}, {"value": "hdmi", "label": "HDMI"}, {"value": "none", "label": "None"}]},
