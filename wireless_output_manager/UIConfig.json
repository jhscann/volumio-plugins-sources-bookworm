{
  "page": {"label": "WIRELESS_OUTPUT_MANAGER"},
  "sections": [
    {
      "id": "speakerSetup",
      "element": "section",
      "label": "SPEAKER_SETUP",
      "icon": "fa-bluetooth-b",
