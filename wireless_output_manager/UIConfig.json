        {"id": "removeOutput", "element": "button", "label": "PLAY_ON_DEFAULT", "description": "SWITCH_OUTPUT_NOTE", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "removeBluetoothOutput", "data": []}}
      ]
    },
    {
      "id": "speakerManagement",
      "element": "section",
      "label": "SAVED_SPEAKER",
      "icon": "fa-headphones",
      "description": "SAVED_SPEAKER_NOTE",
      "content": [
        {"id": "connectDevice", "element": "button", "label": "RECONNECT_SPEAKER", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "connectDevice", "data": []}},
        {"id": "disconnectDevice", "element": "button", "label": "DISCONNECT_SPEAKER", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "disconnectDevice", "data": []}},
        {"id": "forgetDevice", "element": "button", "label": "FORGET_SPEAKER", "description": "FORGET_SPEAKER_NOTE", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "forgetDevice", "data": []}}
      ]
    },
    {
      "id": "preferences",
      "element": "section",
      "label": "PREFERENCES",
      "icon": "fa-cog",
      "onSave": {"type": "controller", "endpoint": "system_hardware/wireless_output_manager", "method": "saveSettings"},
      "saveButton": {"label": "SAVE", "data": ["autoReconnect", "debugLogging"]},
      "content": [
        {"id": "autoReconnect", "element": "switch", "label": "AUTO_RECONNECT_SPEAKER", "description": "AUTO_RECONNECT_NOTE", "value": true},
        {"id": "debugLogging", "element": "switch", "label": "DEBUG_LOGGING", "value": false}
      ]
    },
    {
      "id": "diagnostics",
      "element": "section",
      "label": "DIAGNOSTICS",
      "icon": "fa-stethoscope",
      "description": "DIAGNOSTICS_NOTE",
      "content": [
        {"id": "runDiagnostics", "element": "button", "label": "RUN_DIAGNOSTICS", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "runDiagnostics", "data": []}},
        {"id": "exportDebugLog", "element": "button", "label": "EXPORT_DEBUG_LOG", "onClick": {"type": "plugin", "endpoint": "system_hardware/wireless_output_manager", "method": "exportDebugLog", "data": []}},
        {"id": "refreshUI", "element": "button", "label": "REFRESH_STATUS", "onClick": {"type": "controller", "endpoint": "system_hardware/wireless_output_manager", "method": "getUIConfig", "data": []}},
